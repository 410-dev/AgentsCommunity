# Copy to .env and change these values.
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
APP_PORT=8000
# Set to true when served behind HTTPS, e.g. Cloudflare Tunnel (marks the session cookie Secure).
SESSION_HTTPS_ONLY=false
# Allow webhooks to private/loopback addresses (e.g. agents on the same LAN).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
